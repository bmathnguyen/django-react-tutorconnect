# .env.example for TutorConnect Django Backend
# Copy this file to .env and fill in production secrets

# Django secret key
SECRET_KEY=your-secret-key-here

# Debug mode (True/False)
DEBUG=True

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database settings
DB_NAME=tutoring_db
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432

# Use Postgres (set to 1 for Postgres, blank for SQLite in dev)
USE_POSTGRES=1

# Redis settings
REDIS_URL=redis://localhost:6379/1
USE_REDIS=1

# Any other environment-specific settings can be added below

# CORS_ALLOWED_ORIGINS=https://www.your-frontend-domain.com,https://your-frontend-domain.com

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_HOURS=24
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256
# JWT_SIGNING_KEY=your-secret-key

# File Upload Limits (in bytes)
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.00.1:3000

# Localization
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Ho_Chi_Minh